# --- Streamlit Cloud: App > Settings > Secrets (pegue [auth] y [db]) ---
# --- Computador local (nodo de scraping): .streamlit/secrets.toml con [db] y [medellin] ---
# Nunca suba un secrets.toml real a GitHub ni lo comparta.
[auth]
usuario = "su_usuario"
clave = "una_clave_segura"

[db]
url = "postgresql://postgres.xxxx:SUCLAVE@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Cuenta del portal de Movilidad Medellín (solo en el computador del nodo):
# permite que el nodo inicie sesión solo cuando la sesión vence.
[medellin]
usuario = "su_usuario_del_portal"
clave = "su_clave_del_portal"
